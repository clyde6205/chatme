# Local development. Production values are set as platform secrets/env (docs/deploy-fly.md).
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://chatme:chatme@localhost:5432/chatme
# DATABASE_SSL=disable            # require | verify-full in production
# DATABASE_CA_CERT=               # PEM (\n-escaped ok); required for verify-full
# MIGRATION_DATABASE_URL=         # direct (non-pooled) connection for migrations
# REALTIME_DATABASE_URL=          # session-mode connection for LISTEN/NOTIFY
WEB_ORIGINS=http://localhost:5173
WEB_BASE_URL=http://localhost:5173
COOKIE_SECURE=false
LOG_LEVEL=info

# Email: "log" prints messages (with their links) to the API log. Never use it in production.
EMAIL_PROVIDER=log
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=CHATme <no-reply@mail.chatme.pro>
# EMAIL_REPLY_TO=support@chatme.pro

# AI Gateway (off by default; the ai.assistant feature flag also gates it per user)
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_MODEL=
# AI_DAILY_TOKEN_BUDGET=50000

# Required in production (min 24 chars):
# METRICS_TOKEN=
