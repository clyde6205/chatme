{
  "name": "chatme",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "i18n:check": "pnpm --filter @chatme/i18n check",
    "db:migrate": "pnpm --filter @chatme/api migrate",
    "dev:api": "pnpm --filter @chatme/api dev",
    "dev:web": "pnpm --filter @chatme/web dev",
    "lint": "eslint ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@node-rs/argon2"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "type": "module"
}
